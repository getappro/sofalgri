<data>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">Add weight net</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='quantity']"
                position="before"
            >
                <field name="net_weight"/>
                <field name="crate_quantity"/>
                <field name="crate_product_id"/>
                <field name="crate_weight" readonly="1"/>
                <field name="pallet_weight"/>

                <field name="tare" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</data>