<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_total_weights" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.total.weights</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- On cible la liste des produits dans l'onglet "Opérations" -->
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']"
                position="after"
            >
                <field name="total_net_weight" optional="show"/>
                <field name="total_tare" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>