<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quant_tree_inherit_crates" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.crates</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <!-- On ajoute la colonne après le colis pour une meilleure logique -->
            <xpath expr="//field[@name='package_id']" position="after">
                <field name="crate_quantity" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>