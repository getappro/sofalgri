<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire du Bon de Commande -->
    <!-- On ajoute le prix par colis à côté du prix unitaire -->
    <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.view.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='product_uom_qty']" position="before">
                <field name="product_packaging_qty" optional="show"/>
                <field name="product_packaging_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>