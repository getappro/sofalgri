<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Définition du format papier A5 personnalisé -->
        <record id="paperformat_a5_label" model="report.paperformat">
            <!-- Nom du format pour le retrouver dans l'interface Odoo -->
            <field name="name">Étiquette A5 Personnalisée</field>

            <!-- Format de base. Odoo connaît les formats standards (A4, A5, etc.) -->
            <field name="format">A5</field>

            <!-- Orientation de la page : Portrait ou Landscape -->
            <field name="orientation">Landscape</field>

            <!-- Marges en millimètres. Ajustez selon vos besoins -->
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>

            <!-- En-tête (header) -->
            <field name="header_line" eval="False" /> <!-- Pas de ligne de séparation -->
            <field name="header_spacing">5</field> <!-- Espace en mm pour l'en-tête -->

            <!-- DPI (Dots Per Inch) : la valeur par défaut (90) est généralement correcte -->
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>