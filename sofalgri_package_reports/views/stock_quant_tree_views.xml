<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire: Ajouter le conditionnement dans la liste des quants -->
    <record id="view_stock_quant_list_packaging" model="ir.ui.view">
        <field name="name">stock.quant.list.packaging</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ conditionnement dans la liste des quants -->
            <xpath expr="//field [@name='lot_id']" position="after">
                <field name="product_packaging_qty" optional="show"/>
                <field name="product_packaging_id" optional="show"/>

            </xpath>
        </field>
    </record>
</odoo>
