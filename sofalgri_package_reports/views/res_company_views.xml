<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_company_form_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <field name="currency_id" position="before">
                    <field name="number_export"/>
                    <field name="number_ggn"/>
                    <field name="number_onsa"/>
                    <field name="coc_export"/>
                </field>
            </field>
        </record>

        <record id="stock_warehouse_form_inherit" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="number_station"/>
                    <field name="coc_station"/>
                </field>
            </field>
        </record>
    </data>
</odoo>