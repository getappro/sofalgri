<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template pour rapport de réception -->
    <template id="report_package_reception_template">
          <t t-call="web.html_container">
            <t t-set="o" t-value="doc"/>
            <!-- Filters out package's quants with no quantity. -->
            <t t-set="package_quants" t-value="o.quant_ids.filtered('quantity')"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <!-- HEADER: Package's information -->
                    <div class="row mb-2">
                        <img t-if="o.company_id.logo" class="o_company_logo_big text-center" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                        <div t-if="o.company_id.report_header" t-field="o.company_id.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
                    </div>
                    <div class="row mb-2">
                        <h1 class="text-center">
                            <span>Fiche Palette</span>
                        </h1>
                    </div>
                    <t t-foreach="package_quants.product_id" t-as="product">
                        <t t-set="product_quants" t-value="package_quants.filtered(lambda q: q.product_id.id == product.id)"/>
                        <t t-set="product_qty" t-value="sum(product_quants.mapped('quantity'))"/>
                        <t t-set="product_crate_qty" t-value="sum(product_quants.mapped('crate_quantity'))"/>
                        <!-- Display each individual LN/SN if there is less than 50. -->
                        <t t-set="display_content_details" t-value="0 &lt; len(product_quants.lot_id) &lt; 50"/>
                        <t t-set="aggregate_barcodes" t-value="product_quants.get_aggregate_barcodes()"/>
                        <table class="w-100 table table-sm table-striped">
                            <t t-if="display_content_details or len(aggregate_barcodes) &gt; 1">
                                <t t-if="display_content_details" t-foreach="product_quants[i:i+4] for i in range(0, len(product_quants), 4)" t-as="quants">
                                    <tr t-foreach="quants" t-as="quant">
                                        <td style="width: 30%;">N° de Lot</td>
                                        <td><span t-field="quant.lot_id.name" class="mt-2"/></td>
                                    </tr>
                                </t>
                            </t>
                            <tr>
                                <td style="width:30%;">Nbre Colis</td>
                                <td>
                                    <span t-esc="product_crate_qty"></span>
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 30%;">Produit</td>
                                <td><span t-field="product.display_name"/></td>
                            </tr>
                            <tr>
                                <td style="width: 30%;">Variété</td>
                                <td><span t-field="product.product_variety"/></td>
                            </tr>
                            <tr>
                                <td style="width: 30%;">Poids Brut</td>
                                <td>
                                    <span t-field="o.shipping_weight">3.00</span>
                                    <span t-field="quant.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 30%;">Tare</td>
                                <td>
                                    <span t-field="o.tare">3.00</span>
                                    <span t-field="quant.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                                </td>&gt;
                            </tr>
                            <tr>
                                <td>Poids Net</td>
                                <td>
                                    <span t-esc="product_qty">3.00</span>
                                    <span t-field="quant.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                                </td>
                            </tr>
                        </table>
                    </t>
                    <table class="w-100 table table-sm table-striped">
                        <tbody>
                            <tr>
                                <td>
                                    <div t-if="o.valid_sscc" class="col-6 text-center">
                                        <t t-set="barcode" t-value="'00' + o.name"/>
                                        <t t-if="o.pack_date" t-set="barcode" t-value="barcode + '13' + o.pack_date.strftime('%y%m%d')"/>
                                        <div name="datamatrix_barcode" t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 100, 'height': 100}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                            (package barcode)
                                            </div>
                                        </div>
                                    </div>
                                    <div t-else="" class="col-6 text-center">
                                        <div t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:70px;'}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                            (package barcode)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span style="border-bottom: 1px solid #000; padding-bottom: 5px;text-align: center !important">N° de Palette</span><br/>
                                    <span style="font-size:50px;font-weight: bold;line-height: 60px; text-align: center !important" t-field="o.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="o.packaging_datetime"/>
                                </td>
                                <td>
                                    <div t-if="o.package_type_id" class="o_packaging_type col">
                                        <strong>Package Type:</strong>
                                        <span t-field="o.package_type_id.name">Pallet</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p style="page-break-after: always;"/>
            </t>
    </template>

    <!-- Template pour rapport de remise en stock -->
    <template id="report_package_stock_template">
          <t t-call="web.html_container">
            <t t-set="o" t-value="doc"/>
            <!-- Filters out package's quants with no quantity. -->
            <t t-set="package_quants" t-value="o.quant_ids.filtered('quantity')"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <!-- HEADER: Package's information -->
                    <div class="row mb-2">
                        <img t-if="o.company_id.logo" class="o_company_logo_big text-center" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                        <div t-if="o.company_id.report_header" t-field="o.company_id.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
                    </div>
                    <div class="row mb-2">
                        <h1 class="text-center">
                            <span>Fiche Palette</span>
                        </h1>
                    </div>
                    <div class="oe_structure"/>

                    <!-- Grouper par combinaison produit + packaging -->
                    <t t-set="product_packaging_combinations" t-value="[]"/>
                    <t t-foreach="package_quants" t-as="quant">
                        <t t-set="combo" t-value="(quant.product_id.id, quant.product_packaging_id.id if quant.product_packaging_id else False)"/>
                        <t t-if="combo not in product_packaging_combinations">
                            <t t-set="product_packaging_combinations" t-value="product_packaging_combinations + [combo]"/>
                        </t>
                    </t>

                    <!-- Premier produit pour les informations générales -->
                    <t t-set="first_product" t-value="package_quants[0].product_id"/>

                    <!-- Tableau des informations générales -->
                    <table class="w-100 table table-sm table-striped">
                        <tr>
                            <td style="width:20%;">Exportateur:</td>
                            <td style="width:40%;"><span t-field="o.company_id.name"/></td>
                            <td rowspan="5">
                                <div>N° de Lots:</div>
                                <t t-foreach="package_quants" t-as="quant">
                                    <div>
                                        <span t-field="quant.lot_id.name" class="mt-2"/> - <span t-field="quant.quantity" class="mt-2"/> <span t-field="quant.product_uom_id.name" class="mt-2"/>
                                    </div>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td>Ref. Exportateur:</td>
                            <td>
                                <span t-field="o.company_id.number_export"/>
                            </td>
                        </tr>
                        <tr>
                            <td>Station:</td>
                            <td>
                                <span t-field="o.location_id.warehouse_id.number_station"/>
                            </td>
                        </tr>
                        <tr>
                            <td>Produit:</td>
                            <td>
                                <span t-field="first_product.display_name"/>
                            </td>
                        </tr>
                        <tr>
                            <td>Origine:</td>
                            <td>
                                <span t-field="first_product.country_of_origin"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Tableau des détails produits (une ligne par combinaison) -->
                    <table class="w-100 table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Variété</th>
                                <th>Catégorie</th>
                                <th>Calibre</th>
                                <th>Colis</th>
                                <th>Type de colis</th>
                                <th>Marque</th>
                                <!--<th>Poids Net</th>-->
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="product_packaging_combinations" t-as="combo">
                                <t t-set="product_id" t-value="combo[0]"/>
                                <t t-set="packaging_id" t-value="combo[1]"/>
                                <t t-set="product_quants" t-value="package_quants.filtered(lambda q: q.product_id.id == product_id and (q.product_packaging_id.id if q.product_packaging_id else False) == packaging_id)"/>
                                <t t-set="product" t-value="product_quants[0].product_id"/>
                                <t t-set="product_qty" t-value="sum(product_quants.mapped('quantity'))"/>
                                <t t-set="packaging" t-value="product_quants[0].product_packaging_id if product_quants else False"/>
                                <t t-set="packaging_qty" t-value="sum(product_quants.mapped('product_packaging_qty'))"/>

                                <tr>
                                    <td>
                                        <span t-field="product.product_variety"/>
                                    </td>
                                    <td>
                                        <span t-field="product.product_classify"/>
                                    </td>
                                    <td>
                                        <span t-field="product.calibre"/>
                                    </td>
                                    <td>
                                        <span t-if="packaging" t-esc="int(packaging_qty)"/>
                                    </td>
                                    <td>
                                        <span t-if="packaging" t-field="packaging.name"/>
                                    </td>
                                    <td>
                                        <span t-field="product.product_brand_id.name"/>
                                    </td>
                                   <!-- <td>
                                        <span t-esc="'%.1f' % product_qty"/> <span t-field="product_quants[0].product_uom_id.name"/>
                                    </td>-->
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Section poids total et codes-barres -->
                    <table class="w-100 table table-sm table-striped">
                        <tbody>
                            <tr>
                                <td style="width:30%;">
                                    <span>Poids Net Total:</span>
                                </td>
                                <td colspan="5" style="font-size:18px; font-weight:bold;">
                <!-- MODIFICATION : Calcul de la somme des quantités -->
                <span t-esc="sum(package_quants.mapped('quantity'))" class="mt-2"/>
                <!-- MODIFICATION : Affichage de l'unité de mesure du premier produit -->
                <span t-if="package_quants" t-field="package_quants[0].product_uom_id.name" class="mt-2"/>
            </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div t-if="o.valid_sscc" class="col-6 text-center">
                                        <t t-set="barcode" t-value="'00' + o.name"/>
                                        <t t-if="o.pack_date" t-set="barcode" t-value="barcode + '13' + o.pack_date.strftime('%y%m%d')"/>
                                        <div name="datamatrix_barcode" t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 100, 'height': 100}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                                (package barcode)
                                            </div>
                                        </div>
                                    </div>
                                    <div t-else="" class="col-6 text-center">
                                        <div t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                                (package barcode)
                                            </div>
                                        </div>
                                        <div t-field="o.name">Package Reference</div>
                                    </div>
                                </td>
                                <td colspan="3">
                                    <div class="text-center">
                                        <span> Calibres:</span><br/>
                                        <span style="font-size: 42px; fonct-weight:800;" t-field="first_product.calibre"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-center">
                                        <span> N° de Palette:</span><br/>
                                        <span style="font-size:42px; fonct-weight:800;" t-field="o.name"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5">
                                    <div>
                                        <span>Produits certifiés Global Gap: <span t-field="o.company_id.number_ggn"/></span>
                                    </div>
                                </td>
                                <td>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p style="page-break-after: always;"/>
            </t>
    </template>

     <!-- TEMPLATE PRINCIPAL (WRAPPER) : Le cœur du dynamisme -->
    <template id="report_package_label_template">
        <t t-call="web.basic_layout">
            <!-- Boucle sur chaque palette/colis sélectionné -->
            <t t-foreach="docs" t-as="doc">
                <!-- On appelle le bon template en fonction du type de palette -->
                <t t-if="doc.package_type_id.name == 'Palettes de réception'">
                    <t t-call="sofalgri_package_reports.report_package_reception_template"/>
                </t>
                <t t-if="doc.package_type_id.name == 'Palettes de Livraison'">
                    <t t-call="sofalgri_package_reports.report_package_stock_template"/>
                </t>
                <!-- Message si aucun type n'est défini -->
                <t t-if="not doc.package_type_id">
                    <div class="page">
                        <p>Erreur : Veuillez définir un "Type de Palette" (Réception ou Livraison) pour ce colis.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>